# Auth.js (next-auth) - 用于加密 JWT/session，必填。生成: npx auth secret
AUTH_SECRET=

# Turso Database URL
TURSO_DATABASE_URL=libsql://your-db.io
TURSO_DATABASE_AUTH_TOKEN=eyJhb****your-token

# 远程接口地址
NEXT_PUBLIC_API_BASE_URL=https://jsonplaceholder.typicode.com/

DEEPSEEK_API_KEY=sk-your-api-key

# Resend email API key
RESEND_API_KEY=re_xxxxxxxxx

# Sender address. Development can use Resend's onboarding domain.
EMAIL_FROM=onboarding@resend.dev

# Optional comma-separated recipient allowlist.
# Development defaults to mrvnseason@gmail.com when unset.
EMAIL_ALLOWLIST=mrvnseason@gmail.com