# Auth.js (next-auth) - 用于加密 JWT/session，必填。生成: npx auth secret
AUTH_SECRET=

# Turso Database URL
TURSO_DATABASE_URL=libsql://your-db.io
TURSO_DATABASE_AUTH_TOKEN=eyJhb****your-token

# 普通聊天与开放世界（剧本 / 小说）World Agent 共用；未配置时无法调用 DeepSeek。
DEEPSEEK_API_KEY=sk-your-api-key

# Resend email API key
RESEND_API_KEY=re_xxxxxxxxx

# Sender address. Development can use Resend's onboarding domain.
EMAIL_FROM=onboarding@resend.dev

# Optional comma-separated recipient allowlist.
# Development defaults to mrvnseason@gmail.com when unset.
EMAIL_ALLOWLIST=mrvnseason@gmail.com

# 开放世界存档：本地默认使用 SQLite。
# Vercel 等部署环境请配置远程 libSQL，并提供有写权限的令牌。
# 复用上方的 Turso 时，将 TURSO_DATABASE_URL 和 TURSO_DATABASE_AUTH_TOKEN 的值分别填到下面两个变量。
GROUP_CHAT_DATABASE_URL=file:./db/group-chat.db
GROUP_CHAT_DATABASE_TOKEN=
# 可选：旁白调度展示用模型字段；World Agent 实际仍固定 deepseek/deepseek-chat。
# GROUP_CHAT_DIRECTOR_MODEL=deepseek/deepseek-chat
